{
  "schema_version": 1,
  "study": "Part II — Frozen High-Value Opportunity Selectivity Audit",
  "status": "frozen_before_systematic_run",
  "frozen_date": "2026-09-07",
  "split": "dev",
  "purpose": "Measure whether the already-frozen Experiment 2 X4 strict-OOF probe ranks the high-value and seed-stable opportunities diagnosed by Experiment 6.",
  "interpretation_boundary": "descriptive_limits_evidence_only",
  "pair_ids": [
    "mkgw_mhyper_native",
    "mkgw_mhyper_adamf",
    "mkgw_native_adamf",
    "db15k_mhyper_native",
    "db15k_mhyper_adamf",
    "db15k_native_adamf"
  ],
  "input_contract": {
    "probe": "Experiment 2 X4 nested-selected strict outer-OOF predictions",
    "probe_path_template": "outputs/complementarity_identifiability/exp2_information/runs/{pair_id}/x4/nested_selected/oof_action_predictions.npz",
    "query_asset_path_template": "outputs/complementarity_identifiability/exp2_information/assets/{pair_id}_query_information.npz",
    "utility_manifest_path_template": "outputs/aacpi/utility_tables/{pair_id}_dev_source_manifest.json",
    "stable_query_path": "outputs/complementarity_identifiability/exp6_stable_headroom/stable_headroom_per_query.csv.gz",
    "concentration_path": "outputs/complementarity_identifiability/exp6_stable_headroom/concentration_per_triple.csv.gz",
    "required_prediction_fields": [
      "query_id",
      "outer_fold",
      "fold_global_index",
      "predicted_u",
      "chosen_action_index"
    ],
    "required_query_fields": [
      "query_id",
      "seed",
      "direction",
      "head_id",
      "relation_id",
      "tail_id"
    ],
    "required_seeds": [1, 2, 3],
    "required_directions": ["head", "tail"],
    "alpha_grid": [0.0, 0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 0.6, 0.65, 0.7, 0.75, 0.8, 0.85, 0.9, 0.95, 1.0]
  },
  "analysis_unit": {
    "row": "original_triple_id × direction × seed",
    "cluster": "original_triple_id",
    "stable_identity": "original_triple_id × direction",
    "selection_scope": "within each dataset/expert pair over all strict-OOF rows"
  },
  "ranking_rule": {
    "primary_scalar": "predicted_u[row, chosen_action_index[row]]",
    "global_action_predicted_advantage": 0.0,
    "descending": true,
    "tie_break": ["query_id_lexicographic_ascending"],
    "coverage_fractions": [0.01, 0.05, 0.1, 0.2, 0.3],
    "coverage_count_rule": "ceil(fraction * number_of_rows)",
    "unselected_action": "fold_specific_global",
    "no_score_calibration_or_refit": true
  },
  "targets": {
    "primary_stable_opportunity": "Experiment 6 stable2_nonempty",
    "primary_stable_gain": "Experiment 6 stable2_gain",
    "secondary_stable_opportunity": "Experiment 6 stable3_nonempty",
    "secondary_stable_gain": "Experiment 6 stable3_gain",
    "secondary_consensus_gain": "Experiment 6 consensus_gain",
    "high_gain_definition": "Experiment 6 descending_gain_rank <= ceil(0.10 * pair triple count)",
    "realized_utility": "exact RR at the frozen X4 chosen action minus exact RR at its fold-specific Global action",
    "zero_tolerance": 1e-12
  },
  "metrics": [
    "selected_mean_realized_utility",
    "selective_population_gain",
    "positive_transfer_rate",
    "negative_transfer_rate",
    "changed_rate",
    "stable2_opportunity_rate",
    "stable2_opportunity_enrichment",
    "stable2_gain_capture",
    "stable3_opportunity_rate",
    "stable3_opportunity_enrichment",
    "stable3_gain_capture",
    "consensus_gain_capture",
    "high_gain_precision",
    "high_gain_recall",
    "high_gain_enrichment",
    "raw_oracle_gain_capture"
  ],
  "matched_random_baseline": {
    "samples": 2000,
    "seed": 20260907,
    "strata": ["seed", "direction", "relation_id"],
    "rule": "For every repetition, sample without replacement and preserve the observed selected count in every stratum.",
    "reported": ["mean", "2.5_percentile", "97.5_percentile", "observed_minus_random_mean"]
  },
  "clustered_bootstrap": {
    "samples": 10000,
    "seed": 20260907,
    "unit": "original_triple_id",
    "preserve": ["both_directions", "all_three_seeds", "selected_status", "all_attached_targets"],
    "interval": "percentile_95"
  },
  "decision_rule": {
    "new_route_or_go_gate": false,
    "selector_reopening": false,
    "allowed_conclusion": "Report whether frozen X4 ranking is enriched for stable/high-gain opportunities, without changing the frozen closure route."
  },
  "prohibited": {
    "test_access": 0,
    "new_ranker": 0,
    "new_representation": 0,
    "new_feature": 0,
    "score_selection_after_results": 0,
    "checkpoint_retraining": 0,
    "checkpoint_reselection": 0,
    "policy_tuning": 0,
    "closure_route_change": 0
  },
